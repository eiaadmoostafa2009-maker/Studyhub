# Application
PORT=8080
SECRET_JWT=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Google Cloud Storage bucket containing uploaded Studyhub files
STORAGE_BUCKET=REPLACE_WITH_YOUR_FILE_BUCKET

# SQLite database lives on the VM's Persistent Disk
DATABASE_PATH=/data/studyhub.db

# Admin seed values
ADMIN_NAME=REPLACE_WITH_ADMIN_NAME
ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD

# Litestream uses this bucket for the SQLite replica.
LITESTREAM_BUCKET=REPLACE_WITH_YOUR_LITESTREAM_BUCKET
